<?xml version="1.0"?>
<Container version="2">
  <Name>PiSyncHub-Dev</Name>
  <Repository>ghcr.io/meminiau/pisynchub-dev:latest</Repository>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/meminiau/pisynchub-dev/issues</Support>
  <Project>https://github.com/meminiau/pisynchub-dev</Project>
  <Overview>PiSyncHub is a high-availability sync engine, backup manager, and aggregated telemetry dashboard designed for Pi-hole v6 DNS clusters.</Overview>
  <Category>Network:DNS Tools:Utilities</Category>
  <WebUI>http://[IP]:[PORT:8085]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/meminiau/pisynchub-dev/main/pisynchub.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/meminiau/pisynchub-dev/main/icon.png</Icon>
  <Config Name="WebUI Port" Target="8085" Default="8085" Mode="tcp" Description="Web interface port." Type="Port" Display="always" Required="true" Mask="false">8085</Config>
  <Config Name="Config Storage Path" Target="/config" Default="/mnt/user/appdata/pisynchub-dev" Mode="rw" Description="Host configuration and teleporter backup storage." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/pisynchub-dev</Config>
  <Config Name="Application Port" Target="PORT" Default="8085" Mode="" Description="Internal application listening port." Type="Variable" Display="advanced" Required="true" Mask="false">8085</Config>
  <Config Name="Config Directory" Target="CONFIG_DIR" Default="/config" Mode="" Description="Internal container directory for configuration data." Type="Variable" Display="advanced" Required="true" Mask="false">/config</Config>
</Container>
